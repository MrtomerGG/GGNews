---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GGNEWS — חדשות הגג',
  description = 'חדשות, כתבות וסיפורים מעולם tomer_GG FANCLUB.'
} = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#061a32" />
    <link rel="icon" type="image/png" href="/assets/brand/ggnews-crest-cropped.png" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('ggnews-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">דלגו לתוכן המרכזי</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script src="/scripts/site.js" defer></script>
  </body>
</html>
