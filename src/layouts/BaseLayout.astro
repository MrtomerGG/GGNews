---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import notificationSettings from '../data/notifications.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GGNEWS — חדשות הגג',
  description = 'חדשות, כתבות וסיפורים מעולם tomer_GG FANCLUB.'
} = Astro.props;

const oneSignalAppIdValue = (notificationSettings as { appId?: unknown }).appId;
const oneSignalAppId = typeof oneSignalAppIdValue === 'string' ? oneSignalAppIdValue.trim() : '';
const notificationsConfigured = notificationSettings.enabled
  && /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i.test(oneSignalAppId);
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#061a32" />
    <link rel="icon" type="image/png" href="/assets/brand/ggnews-crest-cropped.png" />
    <link rel="apple-touch-icon" href="/assets/brand/ggnews-crest-cropped.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="GGNEWS" />
    <title>{title}</title>
    {
      notificationsConfigured && (
        <script is:inline src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
      )
    }
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('ggnews-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">דלגו לתוכן המרכזי</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script src="/scripts/site.js" defer></script>
    {notificationsConfigured && <script src="/scripts/notifications.js" defer></script>}
  </body>
</html>
