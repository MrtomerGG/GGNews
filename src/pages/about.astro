---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/support-pages.css';
import '../styles/about.css';

const team = [
  {
    number: '01',
    name: 'אלעד לטעים',
    nickname: '',
    image: '/assets/team/elad.png',
    width: 512,
    height: 512,
    role: 'עורך הדין של חדשות הגג',
    description: 'שומר על תכני המערכת ומוודא שהשימוש בהם נעשה בהגינות ובכבוד.'
  },
  {
    number: '02',
    name: 'עידן פלאבין',
    nickname: '',
    image: '/assets/team/plavinnew.png',
    width: 512,
    height: 512,
    role: 'קריין GGNews',
    description: 'הקול שמלווה את מהדורות החדשות ומחבר את הסיפורים לקהל.'
  },
  {
    number: '03',
    name: 'בראיין רונן',
    nickname: 'הבננה',
    image: '/assets/team/bryan.png',
    width: 512,
    height: 512,
    role: 'כתב/אורח בחדשות הגג',
    description: 'צארלי קירק שלנו'
  },
  {
    number: '04',
    name: 'אייל יצחק',
    nickname: 'איציק',
    image: '/assets/team/eyalizach.png',
    width: 512,
    height: 512,
    role: 'כתב/מדען בחדשות הגג',
    description: 'גילה בעצמו איזה שמן הכי טוב!'
  },
  {
    number: '05',
    name: 'דניאל מנדלסון',
    nickname: '',
    image: '/assets/team/danny2.png',
    width: 1254,
    height: 1254,
    role: 'עורך ראשי בחדשות הגג',
    description: 'הגאון, הגאוט, הגאווה של חדשות הגג'
  },
  {
    number: '06',
    name: 'ליאם שמחי',
    nickname: '',
    image: '/assets/team/liam.png',
    width: 512,
    height: 512,
    role: 'האיש מאחורי הכל',
    description: 'מוביל את העשייה מאחורי הקלעים ושומר שהמערכת תמשיך להתקדם לכאורה והכל'
  },
  {
    number: '07',
    name: 'עידו עזריאל',
    nickname: 'אגוזים',
    image: '/assets/team/nuts.png',
    width: 512,
    height: 512,
    role: 'פרטנר — אולפן הקלטות',
    description: 'בלעדיו פלאבין, אלעד ועוד עובדים טובים שלנו שמופיעים בכתבות לא יכלו להישמע כל כך טוב.'
  },
  {
    number: '08',
    name: 'פלים בריוש',
    nickname: 'אביעד שבי',
    image: '/assets/team/shabi.png',
    width: 512,
    height: 512,
    role: 'שומר ראש של הגג',
    description: 'בעבר רק מעריץ ועכשיו הוא רק ישבור לך את החריץ אם תגע בגג ללא רשות'
  }
];
const founderRoles = ['כתב', 'מנחה', 'בעלים', 'יוצר', 'הגואט', 'הכל'];
---

<BaseLayout
  title="מי אנחנו | GGNews"
  description="הסיפור מאחורי חדשות הגג: תומר גג (GG) והאנשים שמביאים את חדשות הקהילה למסך."
>
  <main class="support-page about-page" id="main-content">
    <section class="support-hero shell" aria-labelledby="about-title">
      <div class="support-hero__copy">
        <span class="support-eyebrow"><span aria-hidden="true"></span> ABOUT GGNEWS</span>
        <h1 id="about-title">הסיפור מאחורי<br /><span>חדשות הגג.</span></h1>
        <p>אנחנו GGNews - המקום חדשות הרשמי לקהילת הפאנקלב המאושרת על ידי ממשלת הגג ואנחנו פה להראות לכם מה קורה בעולם.</p>
        <a class="support-scroll-link" href="#team">להכיר את הצוות <span aria-hidden="true">↓</span></a>
      </div>

      <div class="support-hero__art" aria-hidden="true">
        <img src="/assets/brand/ggnews-crest-cropped.png" alt="" />
      </div>
    </section>

    <section class="founder-section shell" aria-labelledby="founder-name">
      <article class="founder-profile">
        <div class="founder-profile__portrait">
          <img src="/assets/team/tomergg2.png" alt="תומר גג (GG)" width="512" height="512" loading="lazy" decoding="async" />
        </div>
        <div class="founder-profile__copy">
          <span class="section-kicker">האיש מאחורי חדשות הגג</span>
          <h2 id="founder-name">תומר גג <bdi>(GG)</bdi></h2>
          <ul class="founder-profile__roles" aria-label="התפקידים של תומר">
            {founderRoles.map(role => <li>{role}</li>)}
          </ul>
          <div class="founder-profile__quotes">
            <blockquote class="founder-profile__quote"><p>״העולם גדול.<br />תומר יותר.״</p></blockquote>
            <blockquote class="founder-profile__quote founder-profile__quote--secondary"><p>הגג, הבחור בעל היכולת לאכול את כל אויביו.</p></blockquote>
          </div>
        </div>
      </article>
    </section>

    <section class="coverage-band" aria-label="תחומי הסיקור של GGNEWS">
      <div class="shell coverage-band__inner">
        <span>כתבות</span>
        <i aria-hidden="true"></i>
        <span>דיווחים</span>
        <i aria-hidden="true"></i>
        <span>ראיונות</span>
        <i aria-hidden="true"></i>
        <span>וידאו</span>
        <i aria-hidden="true"></i>
        <span>סיפורי קהילה</span>
      </div>
    </section>

    <section class="team-section shell" id="team" aria-labelledby="team-title">
      <div class="support-section-heading">
        <div>
          <span class="section-kicker">האנשים מאחורי החדשות</span>
          <h2 id="team-title">צוות הגג</h2>
        </div>
        <span class="team-count"><strong>{String(team.length).padStart(2, '0')}</strong> אנשי צוות</span>
      </div>

      <div class="team-grid">
        {team.map((member) => (
          <article class="team-card">
            <div class="team-card__media">
              <img src={member.image} alt={`${member.name}${member.nickname ? ` (${member.nickname})` : ''}`} loading="lazy" decoding="async" width={member.width} height={member.height} />
              <span class="team-card__number">{member.number}</span>
            </div>
            <div class="team-card__copy">
              <h3>{member.name}{member.nickname && <span class="team-card__nickname">({member.nickname})</span>}</h3>
              <p class="team-card__role">{member.role}</p>
              <p class="team-card__description">{member.description}</p>
            </div>
            <span class="team-card__line" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </section>

  </main>

</BaseLayout>
