---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/support-pages.css';

const team = [
  {
    number: '01',
    name: 'אלאד לטעים',
    image: '/assets/team/elad-lataim.jpg',
    width: 992,
    height: 992,
    role: 'עורך הדין של חדשות הגג',
    description: 'שומר על תכני המערכת ומוודא שהשימוש בהם נעשה בהגינות ובכבוד.'
  },
  {
    number: '02',
    name: 'פלאבין',
    image: '/assets/team/plavin.jpg',
    width: 765,
    height: 765,
    role: 'קריין GGNews',
    description: 'הקול שמלווה את מהדורות החדשות ומחבר את הסיפורים לקהל.'
  },
  {
    number: '03',
    name: 'ליאם שמח',
    image: '/assets/team/liam-sameach.jpg',
    width: 992,
    height: 992,
    role: 'האיש מאחורי הכול',
    description: 'מוביל את העשייה מאחורי הקלעים ושומר שהמערכת תמשיך להתקדם.'
  }
];
---

<BaseLayout
  title="מי אנחנו | GGNews"
  description="הכירו את GGNews, את צוות הגג ואת tomer_GG."
>
  <main class="support-page about-page" id="main-content">
    <section class="support-hero shell" aria-labelledby="about-title">
      <div class="support-hero__copy">
        <span class="support-eyebrow"><span aria-hidden="true"></span> ABOUT GGNEWS</span>
        <h1 id="about-title">הסיפור מאחורי<br /><span>חדשות הגג.</span></h1>
        <p>אנחנו GGNews - המקום חדשות הרשמי לקהילת הפאנקלב המאושרת על ידי ממשלת הגג ואנחנו פה להראות לכם מה קורה בעולם.</p>
        <a class="support-scroll-link" href="#team">להכיר את הצוות <span aria-hidden="true">↓</span></a>
      </div>

      <div class="support-hero__art" aria-hidden="true">
        <div class="support-hero__orbit support-hero__orbit--one"></div>
        <div class="support-hero__orbit support-hero__orbit--two"></div>
        <span class="support-hero__code"></span>
        <img src="/assets/brand/ggnews-crest-cropped.png" alt="" />
      </div>
    </section>

    <section class="about-intro shell" aria-labelledby="intro-title">
      <div class="about-intro__heading">
        <span class="support-index">01</span>
        <div>
          <span class="section-kicker">האיש וההגדה</span>
          <h2 id="intro-title">העולם גדול. תומר יותר.</h2>
        </div>
      </div>

      <div class="about-intro__body">
        <article class="tomer-intro">
          <img src="/assets/team/tomer-gg.jpg" alt="תומר גג" width="651" height="631" />
          <div class="tomer-intro__copy">
            <span>tomer_GG</span>
            <h3>תומר גג</h3>
            <p class="tomer-intro__role">הגואט</p>
            <p>הגג, הבחור בעל היכולת לאכול את כל אויביו.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="coverage-band" aria-label="תחומי הסיקור של GGNEWS">
      <div class="shell coverage-band__inner">
        <span>כתבות</span>
        <i aria-hidden="true"></i>
        <span>דיווחים</span>
        <i aria-hidden="true"></i>
        <span>ראיונות</span>
        <i aria-hidden="true"></i>
        <span>וידאו</span>
        <i aria-hidden="true"></i>
        <span>סיפורי קהילה</span>
      </div>
    </section>

    <section class="team-section shell" id="team" aria-labelledby="team-title">
      <div class="support-section-heading">
        <div>
          <span class="section-kicker">האנשים מאחורי החדשות</span>
          <h2 id="team-title">צוות הגג</h2>
        </div>
      </div>

      <div class="team-grid">
        {team.map((member) => (
          <article class="team-card">
            <div class="team-card__media">
              <img src={member.image} alt={member.name} loading="lazy" width={member.width} height={member.height} />
              <span class="team-card__number">{member.number}</span>
            </div>
            <div class="team-card__copy">
              <h3>{member.name}</h3>
              <p class="team-card__role">{member.role}</p>
              <p class="team-card__description">{member.description}</p>
            </div>
            <span class="team-card__line" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </section>

  </main>

</BaseLayout>
